# Dependencies
node_modules

# Build output
.next
out
build
*.tsbuildinfo
next-env.d.ts

# Secrets.
# `.env`, `.env.production.local` and friends hold live database credentials,
# JWT signing secrets, SES and S3 keys. `.env.example` documents the key names
# with no values and is the only one tracked.
.env
.env.*
!.env.example

*.pem
*.p8
*.key
*serviceAccount*.json

# Generated email previews — build artefacts produced by db/preview-emails.ts,
# regenerated on demand. Committing them means every copy change shows up as
# dozens of unreadable HTML diffs.
db/email-preview/

# Local tooling
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.idea
.vscode/*
!.vscode/extensions.json
coverage
