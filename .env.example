# Shathi API — environment
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
#
# Every value below previously had a hardcoded fallback in
# src/config/constants.ts, which is tracked in git. All of them must be
# ROTATED before this file is used — see SECURITY-REMEDIATION.md.
#
# The app throws on startup if any required variable is missing. That is
# intentional: failing loudly beats silently falling back to a public secret.

# ---------------------------------------------------------------- General --
API_URL=https://api.digigramventures.com/

# Signs session tokens. Generate a new one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this logs every user out once.
JWT_SECRET=

# -------------------------------------------------------------------- SMS --
BULK_SMS_API_KEY=
BULK_SMS_SENDER_ID=

# OTP lifetime in milliseconds (default 300000 = 5 minutes)
OTP_EXPIRY=300000
# Seconds before a number may request another code
OTP_RESEND_COOLDOWN=60
# Wrong attempts before the code is burned
OTP_MAX_ATTEMPTS=5

# App-store review bypass. Leave OTP_REVIEW_ENABLED=false everywhere except a
# review build. Both phone and code must also be set for it to work.
OTP_REVIEW_ENABLED=false
OTP_REVIEW_PHONE=
OTP_REVIEW_CODE=

# --------------------------------------------------------------------- S3 --
S3_BUCKET_NAME=
S3_BUCKET_REGION=ap-southeast-1
S3_BUCKET_ACCESS_KEY=
S3_BUCKET_SECRET_KEY=
S3_URL=

# ------------------------------------------------------------------ MySQL --
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# ----------------------------------------------------------------- Social --
GOOGLE_CLIENT_ID=

APPLE_CLIENT_ID=com.digigram.saathi
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM on ONE line, real newlines written as \n
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"

# -------------------------------------------------------------------- SES --
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_AWS_REGION=ap-northeast-1

# ------------------------------------------------------------------- CORS --
# Comma-separated list of origins allowed to call this API from a browser.
# `*` restores the old permissive behaviour. Set the real list in production.
CORS_ALLOWED_ORIGINS=https://digigramventures.com,https://www.digigramventures.com

# --- Browser-visible configuration ------------------------------------
# Only NEXT_PUBLIC_* variables are compiled into client JavaScript. Admin
# pages read these two from src/config/public.ts; everything else in this
# file stays server-side. Keep each pair in sync with its unprefixed twin.
NEXT_PUBLIC_API_URL=/
NEXT_PUBLIC_S3_URL=

# ------------------------------------------------------ email verification --
# Envelope sender. Must be an address SES has verified for this account, or
# every send fails with MessageRejected.
EMAIL_FROM="Shathi <msg@notification.n.digigramventures.com>"

# Public origin of the website, used to build verification links. No trailing
# slash. SET THIS PER ENVIRONMENT — a wrong value sends people to a link that
# 404s, and the default is the production site.
WEB_BASE_URL=https://new.digigramventures.com

# Milliseconds a verification code and link stay valid.
EMAIL_VERIFICATION_EXPIRY=1800000
# Seconds before another code can be requested. Longer than the SMS cooldown:
# email delivery is slower, and a short window mostly produces people holding
# three codes and trying the wrong one.
EMAIL_VERIFICATION_RESEND_COOLDOWN=120
# Wrong-code attempts before the code is burned.
EMAIL_VERIFICATION_MAX_ATTEMPTS=6
